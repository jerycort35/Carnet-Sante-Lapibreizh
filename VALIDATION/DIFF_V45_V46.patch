+// Explain existing reproduction restrictions without removing color matches.
+class ReproductionAvailability{
+  static List<String> reasons({required Map<String,dynamic> female,
+    required Iterable<Map<String,dynamic>> records,required int maxLitters,
+    required int restDays,DateTime? now}){
+    final today=now??DateTime.now();
+    final out=<String>[];
+    for(final raw in ((female['medications'] as List?)??[])){
+      final med=Map<String,dynamic>.from(raw as Map);
+      final start=Notifications.parseDate(med['startDate'] as String?);
+      final end=Notifications.parseDate(med['endDate'] as String?);
+      if(start==null)continue;
+      final startDay=DateTime(start.year,start.month,start.day);
+      final endDay=end==null?null:DateTime(end.year,end.month,end.day,23,59);
+      if(!startDay.isAfter(today)&&(endDay==null||!endDay.isBefore(today))){
+        out.add('Traitement médical actif chez la femelle. Attendre la fin du traitement et l’avis du vétérinaire.');
+        break;
+      }
+    }
+    final cutoff=today.subtract(const Duration(days:365));
+    final births=records.where((b)=>b['femaleId']==female['id'])
+      .map((b)=>Notifications.parseDate(b['birthDate'] as String?)).whereType<DateTime>().toList();
+    final count12m=births.where((d)=>!d.isBefore(cutoff)).length;
+    if(count12m>=maxLitters){
+      out.add('Quota annuel atteint : $count12m portée(s) sur les 12 derniers mois, pour un maximum de $maxLitters.');
+    }
+    if(restDays>0&&births.isNotEmpty){
+      births.sort();
+      final elapsed=today.difference(births.last).inDays;
+      if(elapsed<restDays){
+        out.add('Période de repos non terminée : ${restDays-elapsed} jour(s) restant(s), pour un repos minimum de $restDays jours après la dernière naissance.');
+      }
+    }
+    return out;
+  }
+}
